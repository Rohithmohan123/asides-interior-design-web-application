# Copy this file to .env and change the values. Never commit your real .env.
PORT=3000
DB_PATH=data/asides.db

# Admin CMS login (single administrator). Choose your own strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=replace-with-a-random-64-character-hex-string

# Max enquiries per IP address per 10 minutes
ENQUIRY_RATE_LIMIT=5
